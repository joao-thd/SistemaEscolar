@model List<SistemaEscolarV1.Models.Turno>

@{
    ViewData["Title"] = "Gerenciar Notas";
}

<h2 class="text-center">@ViewData["Title"]</h2>

<div class="turnos-container">
    <h4 class="text-center">Escolha o turno:</h4>
    <div class="turnos-list">
        @foreach (var turno in Model)
        {
            <div class="turno-item">
                <!-- Link para escolher o ano, passando o turno -->
                <a href="@Url.Action("EscolherAno", "Professor", new { turnoescolhido = turno.Nome })" class="btn btn-turno">@turno.Nome</a>
            </div>
        }
    </div>
</div>

<style>
    /* Estiliza a área principal da página */
    .turnos-container {
        margin-top: 30px;
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    /* Centraliza o título */
    .text-center {
        text-align: center;
    }

    /* Estiliza os itens do container dos turnos */
    .turnos-list {
        display: flex;
        justify-content: center;
        gap: 20px; /* Espaço entre os botões */
        flex-wrap: wrap;
    }

    /* Estiliza cada item de turno */
    .turno-item {
        display: flex;
        justify-content: center;
        margin-top: 15px;
    }

    /* Estilização dos botões de turno */
    .btn-turno {
        padding: 15px 25px;
        font-size: 18px;
        border-radius: 50px; /* Bordas arredondadas */
        background-color: #007bff; /* Cor azul */
        color: white;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

        /* Efeito de hover nos botões */
        .btn-turno:hover {
            background-color: #0056b3; /* Azul mais escuro no hover */
            transform: scale(1.05); /* Efeito de aumento suave */
        }

        /* Efeito de foco no botão */
        .btn-turno:focus {
            outline: none; /* Remove a borda padrão do foco */
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.5); /* Adiciona um foco personalizado */
        }

    /* Estiliza o fundo da página */
    body {
        background-color: #e9ecef; /* Fundo suave para a página */
    }

</style>
