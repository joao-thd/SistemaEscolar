@model List<SistemaEscolarV1.Models.Nota>

@{
    ViewData["Title"] = "Gerenciar Notas";
}

<h1>@ViewData["Title"]</h1>

<!-- Tabela de Notas -->
<div class="container">
    <table class="table">
        <thead>
            <tr>
                <th>Aluno</th>
                <th>Nota</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var nota in Model)
            {
                <tr>
                    <td>@nota.AlunoNome</td>
                    <td>@nota.Valor</td>
                    <td>
                        
                        <a href="@Url.Action("Editar", "Professor", new { id = nota.Id })" class="btn btn-warning">Editar</a>
                        <a href="@Url.Action("Excluir", "Professor", new { id = nota.Id })" class="btn btn-danger" onclick="return confirm('Tem certeza que deseja excluir esta nota?')">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Formulário para adicionar uma nova nota -->
<div class="container">
    <h2>Adicionar Nota</h2>
    <form method="post" asp-action="AdicionarNota">
        <div class="form-group">
            <label for="alunoId">Aluno</label>
            <select id="alunoId" name="alunoId" class="form-control">
                
                <option value="1">João Silva</option>
                <option value="2">Maria Oliveira</option>
            </select>
        </div>
        <div class="form-group">
            <label for="nota">Nota</label>
            <input type="number" id="nota" name="nota" class="form-control" min="0" max="10" required />
        </div>
        <button type="submit" class="btn btn-primary">Adicionar</button>
    </form>
</div>


@if (ViewData["EditarNota"] != null)
{
    var notaEditar = (SistemaEscolarV1.Models.Nota)ViewData["EditarNota"];
    <div class="container">
        <h2>Editar Nota</h2>
        <form method="post" asp-action="Editar">
            <input type="hidden" name="Id" value="@notaEditar.Id" />
            <div class="form-group">
                <label for="nota">Nota</label>
                <input type="number" id="nota" name="nota" class="form-control" value="@notaEditar.Valor" min="0" max="10" required />
            </div>
            <button type="submit" class="btn btn-success">Salvar</button>
        </form>
    </div>
}
